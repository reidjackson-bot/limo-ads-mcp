# Connector URL becomes https://<railway-host>/<MCP_PATH_SECRET>/mcp
MCP_PATH_SECRET=generate-with-openssl-rand-hex-24

# Google Ads (reuse the credentials from the call-conversion worker)
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_REFRESH_TOKEN=
GOOGLE_ADS_LOGIN_CUSTOMER_ID=     # MCC ID if you access the account through one, else blank
GOOGLE_ADS_CUSTOMER_ID=           # the limo account, digits only

# Guardrails
WRITE_MODE=propose                # propose | auto
MAX_AUTO_BUDGET_CHANGE_PCT=20
MAX_DAILY_BUDGET=150
AUTO_CAMPAIGN_STATUS=false

# Mount a Railway volume at /data so the change log survives deploys
DB_PATH=/data/limo_ads.db

# CallRail (Settings > Integrations > API keys)
CALLRAIL_API_KEY=
CALLRAIL_ACCOUNT_ID=
CALLRAIL_COMPANY_ID=
CALLRAIL_ADS_TRACKER_ID=          # find it with the callrail_trackers tool after first deploy
